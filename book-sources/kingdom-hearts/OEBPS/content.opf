  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="uid">urn:uuid:6f1c2a52-8f0e-4b8e-9a51-6b1e3c2d04a1</dc:identifier>
    <dc:title id="t1">Kingdom Hearts: A Journey of Light &amp; Darkness</dc:title>
    <dc:creator>A Fan Companion</dc:creator>
    <dc:language>en</dc:language>
    <dc:description>Three friends on a tiny island. A key shaped like a sword. Twenty-plus years of games, worlds, songs and a story that famously refuses to be simple. This companion walks the whole saga, from the elevator chat that started it to the road toward Kingdom Hearts IV.</dc:description>
    <dc:subject>Video games</dc:subject>
